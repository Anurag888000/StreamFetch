# Environment Configuration
# Path to yt-dlp binary (if not in system PATH)
# Examples:
# Windows: C:\Users\Anurag\AppData\Local\Microsoft\WinGet\Packages\yt-dlp.yt-dlp_Microsoft.Winget.Source_8wekyb3d8bbwe\yt-dlp.exe
# or yt-dlp if installed in PATH
YTDLP_PATH=yt-dlp

# Path to ffmpeg binary (if not in system PATH)
FFMPEG_PATH=ffmpeg

# Storage directory for temporary downloads (relative to project root or absolute)
DOWNLOAD_DIR=.tmp/downloads

# Cleanup interval in minutes
FILE_TTL_MINUTES=60

# Detailed API & Engine Logging (true = enabled with console & /logs file persistence, false = muted)
ENABLE_LOGGING=true
